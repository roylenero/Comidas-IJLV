# Configuración PÚBLICA del SDK web de Firebase (Consola → Configuración del proyecto → Tus apps → Web).
# Estos valores identifican al proyecto; NO son secretos ni sustituyen a las reglas de seguridad.
# Copia este archivo como .env.local y completa los valores. Nunca pongas aquí credenciales de service account.
VITE_FIREBASE_API_KEY=
# Usa el valor que da Firebase (tu-proyecto.firebaseapp.com). Ver README → "Acceso con Google en iPhone".
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase lo incluye en la configuración, pero la app NO usa Storage y no lee esta variable.
VITE_FIREBASE_STORAGE_BUCKET=

# Desarrollo local contra Firebase Emulator Suite (no toca datos reales).
# Con "true" no hace falta completar lo anterior.
VITE_USE_EMULATORS=false
